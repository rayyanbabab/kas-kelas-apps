# DATABASE_URL: Neon Serverless PostgreSQL connection string
# Dapatkan connection string dari dashboard https://neon.tech
# Format: postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# Port untuk API server (opsional, default 3001)
PORT=3001

# GEMINI_API_KEY: Required for Gemini AI API calls (jika ada fitur AI).
GEMINI_API_KEY=""

# APP_URL: URL aplikasi
APP_URL="http://localhost:3000"
